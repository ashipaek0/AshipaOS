#!/bin/sh
# Writes a boot report to the SD card's FAT boot partition so a unit without a
# UART can be diagnosed from a PC: put the card in a PC and read
# ashipaos-stage3-linux.txt. Read-only diagnostics; writes nothing else.
set -u
out_dir=/boot/firmware
report="$out_dir/ashipaos-stage3-linux.txt"
mountpoint -q "$out_dir" || mount "$out_dir" || exit 0
tmp="$report.partial"
{
    echo "== AshipaOS boot report (stage 3: Linux userspace) =="
    date -u '+%Y-%m-%dT%H:%M:%SZ (may be wrong before NTP)'
    echo "uptime: $(cat /proc/uptime)"
    echo "report written by: $0 (rewritten 1, 3 and 10 minutes after boot)"
    echo "kernel: $(uname -a)"
    echo "cmdline: $(cat /proc/cmdline)"
    echo "model: $(tr -d '\0' </proc/device-tree/model 2>/dev/null)"
    echo; echo "== failed units =="; systemctl --failed --no-pager --no-legend
    echo; echo "== jellyfin mpv shim =="; systemctl status ashipaos-jellyfin-mpv-shim.service --no-pager -l -n 0
    echo; echo "== jellyfin mpv shim log (this boot, all priorities) =="
    journalctl -b -u ashipaos-jellyfin-mpv-shim.service --no-pager -o short-monotonic -n 600
    echo; echo "== jellyfin mpv shim config =="; ls -la /storage/jellyfin-mpv-shim 2>&1
    echo; echo "== clock =="; timedatectl 2>&1
    echo; echo "== IR remote =="; ir-keytable 2>&1 | head -n 20
    echo; echo "== IR remote: decoded presses this boot (scancode -> keycode) =="
    journalctl -b -u ashipaos-ir-log.service --no-pager -n 200
    echo; echo "== display/input/audio devices =="; ls -l /dev/dri /dev/input /dev/snd 2>&1
    echo; echo "== ALSA cards (/etc/asound.conf assumes card 0 is the HDMI output) =="
    cat /proc/asound/cards 2>&1
    aplay -l 2>&1
    echo; echo "== hardware video decode (v4l2m2m for mpv's hwdec) =="; ls -l /dev/video* 2>&1
    echo; echo "== network =="; ip -brief address 2>&1; networkctl --no-pager 2>&1
    echo; echo "== wi-fi =="
    for dev in /sys/bus/sdio/devices/*; do
        [ -e "$dev/vendor" ] && echo "sdio $(basename "$dev"): vendor=$(cat "$dev/vendor") device=$(cat "$dev/device") class=$(cat "$dev/class" 2>/dev/null)"
    done
    dmesg | grep -iE 'brcm|wlan|firmware' | tail -n 40
    echo "iwd networks configured: $(ls /var/lib/iwd 2>/dev/null | wc -l)"
    iwctl station list 2>&1 | head -n 20
    journalctl -b -u iwd.service -u ashipaos-wifi-import.service --no-pager -n 60
    echo; echo "== journal warnings (this boot) =="; journalctl -b -p warning --no-pager -n 300
    echo; echo "== kernel log (tail) =="; dmesg | tail -n 300
} >"$tmp" 2>&1
mv -f "$tmp" "$report"
sync
