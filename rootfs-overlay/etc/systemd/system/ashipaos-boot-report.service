# No-UART diagnostics: rewrite ashipaos-stage3-linux.txt on the SD card's boot
# partition (LABEL=A95XBOOT, mounted at /boot/firmware) 1, 3 and 10 minutes
# after boot. Type=simple and no After=multi-user.target, so it never holds up
# or cycles with the boot target.
[Unit]
Description=AshipaOS boot report on the SD boot partition
After=local-fs.target

[Service]
Type=simple
ExecStart=/bin/sh -c 'for delay in 60 120 420; do sleep $delay; /usr/libexec/ashipaos-boot-report; done'

[Install]
WantedBy=multi-user.target
