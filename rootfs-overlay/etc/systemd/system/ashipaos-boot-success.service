[Unit]
Description=AshipaOS boot readiness marker
Requires=ashipaos-boot-status.service
After=ashipaos-boot-status.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'systemctl is-active --quiet ashipaos-boot-status.service && printf "ASHIPAOS_BOOT_SUCCESS=1\n" > /dev/console'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
