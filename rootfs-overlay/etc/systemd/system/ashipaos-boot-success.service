[Unit]
Description=AshipaOS graphical boot readiness marker
Requires=ashipaos-display.service
After=ashipaos-display.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'systemctl is-active --quiet ashipaos-display.service && printf "ASHIPAOS_BOOT_SUCCESS=1\n" > /dev/console'
RemainAfterExit=yes

[Install]
WantedBy=graphical.target
