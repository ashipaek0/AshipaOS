[Unit]
Description=AshipaOS boot status endpoint
# Listens on all interfaces as they come up; never waits for a network.
After=network.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/bin/busybox nc -ll -p 8080 -e /usr/libexec/ashipaos-boot-status-handler
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
