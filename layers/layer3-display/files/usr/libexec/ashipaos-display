#!/usr/bin/env bash
# Layer 3 owns the compositor/session; Layer 5 owns the application launcher.
set -Eeuo pipefail

command -v /usr/libexec/ashipaos-jellyfin-mpv-shim >/dev/null 2>&1 \
    || { printf '%s\n' 'ashipaos-display: validated Jellyfin MPV Shim launcher unavailable' >&2; exit 1; }
exec /usr/bin/cage -- /usr/libexec/ashipaos-jellyfin-mpv-shim
