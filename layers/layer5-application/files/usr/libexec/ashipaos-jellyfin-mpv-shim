#!/usr/bin/env bash
set -Eeuo pipefail
# Run the one application bundle this root slot was built with, after
# validating its manifest, hash and ownership. There is deliberately no other
# candidate to fall back to or select between: an OS update (contracts/os-ota.md)
# replaces this whole root slot atomically, so the bundle here is always
# exactly what this build shipped, never independently swapped.
BUNDLE="${ASHIPAOS_BUNDLE:-/usr/lib/ashipaos/apps/jellyfin-mpv-shim}"
CONFIG="${ASHIPAOS_CONFIG:-/storage/jellyfin-mpv-shim}"
DEFAULTS="${ASHIPAOS_DEFAULTS:-/usr/share/ashipaos/jellyfin-mpv-shim}"
EXPECTED_NAME="jellyfin-mpv-shim"
error() { printf 'jellyfin-mpv-shim: %s\n' "$*" >&2; exit 1; }

owned_mode() {
    local path="$1" owner="$2" group="$3" mode="$4" actual_owner actual_group actual_mode
    [[ -e "$path" && ! -L "$path" ]] || return 1
    read -r actual_owner actual_group actual_mode < <(stat -c '%u %g %a' "$path") || return 1
    [[ "$actual_owner" == "$owner" && "$actual_group" == "$group" && "$actual_mode" == "$mode" ]]
}

# getent (not id): resolves the ashipa identity through NSS the same way on
# the target and in tests, without requiring the caller to already be ashipa.
IFS=: read -r _ _ ashipa_uid ashipa_gid _ < <(getent passwd ashipa) || error "the ashipa user is missing"
[[ -n "$ashipa_uid" && -n "$ashipa_gid" ]] || error "could not resolve the ashipa user"

[[ -d "$CONFIG" ]] || install -d -m 0700 "$CONFIG" || error "cannot create configuration directory"
owned_mode "$CONFIG" "$ashipa_uid" "$ashipa_gid" 700 || error "configuration ownership or mode is invalid"
# First boot: seed the appliance defaults (fullscreen browser, DRM output).
# Existing files are never overwritten, so settings changed in the UI persist.
for default in conf.json mpv.conf; do
    if [[ -f "$DEFAULTS/$default" && ! -e "$CONFIG/$default" ]]; then
        install -m 0600 "$DEFAULTS/$default" "$CONFIG/$default" || error "cannot seed $default"
    fi
done

manifest="$BUNDLE/manifest.json"
owned_mode "$BUNDLE" 0 0 755 || error "bundle directory ownership or mode is invalid"
[[ -f "$manifest" && ! -L "$manifest" ]] || error "bundle manifest is missing"
owned_mode "$manifest" 0 0 644 || error "bundle manifest ownership or mode is invalid"
[[ -f "$BUNDLE/bin/$EXPECTED_NAME" && ! -L "$BUNDLE/bin/$EXPECTED_NAME" ]] || error "bundle executable is missing"
owned_mode "$BUNDLE/bin/$EXPECTED_NAME" 0 0 755 || error "bundle executable ownership or mode is invalid"
[[ -x "$BUNDLE/bin/$EXPECTED_NAME" ]] || error "bundle executable is not executable"

python3 - "$manifest" "$EXPECTED_NAME" <<'PY' || error "bundle manifest failed validation"
import json, sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
required = {"schema", "name", "version", "executable", "sha256", "python_tag", "abi_tag", "platform_tag", "dependency_status"}
assert set(value) == required and value["schema"] == "ashipaos.jellyfin-mpv-shim.slot.v1"
assert value["name"] == sys.argv[2]
assert value["executable"] == f"bin/{sys.argv[2]}" and value["dependency_status"] == "RESOLVED"
assert isinstance(value["python_tag"], str) and value["python_tag"].startswith("cp3")
assert isinstance(value["abi_tag"], str) and value["abi_tag"].startswith("cp3")
assert isinstance(value["platform_tag"], str) and "aarch64" in value["platform_tag"]
assert isinstance(value["version"], str) and value["version"]
sha256 = value["sha256"]
assert isinstance(sha256, str) and len(sha256) == 64 and all(c in "0123456789abcdef" for c in sha256)
PY

expected_hash="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["sha256"])' "$manifest")"
actual_hash="$(sha256sum "$BUNDLE/bin/$EXPECTED_NAME" | awk '{print $1}')"
[[ "$actual_hash" == "$expected_hash" ]] || error "bundle executable does not match its manifest hash"

exec "$BUNDLE/bin/$EXPECTED_NAME" "$@"
