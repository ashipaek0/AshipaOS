# AshipaOS A95X F3 Air: mainline U-Boot chain-loaded from SD as u-boot.ext.
# Merged on top of bananapi-m5_defconfig (plain SM1, generic u200 board code).
CONFIG_DEFAULT_DEVICE_TREE="amlogic/meson-sm1-a95xf3-air"
CONFIG_IDENT_STRING=" ashipaos-a95x-f3-air"
# The environment lives in RAM only: nothing can ever be saved to eMMC.
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_MMC is not set
# No tools that could write the box's eMMC from U-Boot.
# CONFIG_CMD_DFU is not set
# CONFIG_CMD_USB_MASS_STORAGE is not set
# CONFIG_CMD_GPT is not set
# CONFIG_USB_GADGET is not set
# FAT writes are used only for the boot log on the SD card's own partition.
CONFIG_FAT_WRITE=y
CONFIG_CMD_EXPORTENV=y
# Records the exact U-Boot build in the stage-2 boot log ("ver").
CONFIG_VERSION_VARIABLE=y
# Show U-Boot's console on HDMI as well as the UART (no-UART diagnostics).
CONFIG_CONSOLE_MUX=y
CONFIG_SYS_CONSOLE_IS_IN_ENV=y
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="setenv stdout serial,vidconsole; setenv stderr serial,vidconsole"
CONFIG_BOOTDELAY=2
# Boot only the AshipaOS SD card (see boot.cmd in build-image.sh).
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="for d in 0 1 2; do if test -e mmc ${d}:1 ashipaos.id; then setenv ashipa_dev ${d}; fi; done; if test -n \"${ashipa_dev}\"; then load mmc ${ashipa_dev}:1 ${scriptaddr} boot.scr && source ${scriptaddr}; fi; echo AshipaOS: no bootable AshipaOS SD card found"
