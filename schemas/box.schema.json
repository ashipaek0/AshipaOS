{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AshipaOS Amlogic box hardware facts",
  "description": "Hardware-facts schema for build/targets/amlogic/boxes/*.yaml (Layer 0, per guide Task 0.5.1).",
  "type": "object",
  "required": ["name", "status", "soc", "kernel_branch", "coreelec"],
  "properties": {
    "name": { "type": "string" },
    "status": {
      "type": "object",
      "required": ["device_tree", "wifi", "bluetooth", "ir", "hardware_decode"],
      "properties": {
        "device_tree": { "type": "string" },
        "wifi": { "type": "string" },
        "bluetooth": { "type": "string" },
        "ir": { "type": "string" },
        "hardware_decode": { "type": "string" }
      }
    },
    "soc": {
      "type": "object",
      "required": ["value", "status"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "status": { "type": "string" }
      }
    },
    "kernel_branch": {
      "type": "object",
      "required": ["value", "status"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "status": { "type": "string" }
      }
    },
    "coreelec": {
      "type": "object",
      "required": ["repository", "ref", "commit", "project", "device"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://" },
        "ref": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "project": { "const": "Amlogic-ce" },
        "device": { "enum": ["Amlogic-ng", "Amlogic-ne"] }
      },
      "additionalProperties": false
    },
    "device_tree": { "type": "object" },
    "wifi": { "type": "object" },
    "bluetooth": { "type": "object" },
    "ram": { "type": "object" },
    "ir": { "type": "object" },
    "cec": { "type": "object" },
    "audio": { "type": "object" },
    "power": { "type": "object" },
    "storage": { "type": "object" },
    "boot": { "type": "object" }
  },
  "additionalProperties": true
}
