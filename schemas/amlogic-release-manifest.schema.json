{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AshipaOS Amlogic development manifest",
  "type": "object",
  "required": ["schema_version", "version", "target", "track", "project", "device", "source_commit", "coreelec_commit", "artifacts", "verification"],
  "properties": {
    "schema_version": { "const": 1 },
    "version": { "const": "0.0.1-dev" },
    "target": { "const": "a95x-f3-air" },
    "track": { "const": "coreelec-baseline" },
    "project": { "const": "Amlogic-ce" },
    "device": { "const": "Amlogic-ng" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "coreelec_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string", "pattern": "Generic.*\\.img\\.gz$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": ["build", "hardware"],
      "properties": {
        "build": { "const": "passed" },
        "hardware": { "const": "blocked" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
