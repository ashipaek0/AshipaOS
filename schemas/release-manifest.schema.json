{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AshipaOS release manifest",
  "type": "object",
  "required": ["schema_version", "version", "build_id", "target", "source_commit", "inputs_sha256", "kernel_version", "image", "sha256", "packages_lock", "verification"],
  "properties": {
    "schema_version": { "const": 1 },
    "version": { "type": "string", "minLength": 1 },
    "build_id": { "type": "string", "pattern": "^[0-9a-f]{12}-[0-9a-f]{12}$" },
    "target": { "const": "x86_64" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "inputs_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "kernel_version": { "type": "string", "minLength": 1 },
    "image": { "type": "string", "pattern": "\\.img\\.zst$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "packages_lock": {
      "type": "object",
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string", "pattern": "^ashipaos-x86_64\\.packages\\.lock$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["build", "vm", "hardware"],
      "properties": {
        "build": { "enum": ["pending-ci", "passed", "failed"] },
        "vm": { "enum": ["pending-ci", "passed", "failed"] },
        "hardware": { "enum": ["blocked", "passed", "failed"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
