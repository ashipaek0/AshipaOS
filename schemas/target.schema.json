{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AshipaOS build target",
  "description": "Minimal target stub schema (Layer 0). Extended by later layers.",
  "type": "object",
  "required": ["name", "arch", "status"],
  "properties": {
    "name": { "type": "string" },
    "arch": { "type": "string", "enum": ["arm64", "x86_64"] },
    "status": { "type": "string", "enum": ["PROVISIONAL", "CONFIRMED"] }
  },
  "additionalProperties": true
}
