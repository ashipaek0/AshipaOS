{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AshipaOS A95X release target (build/config/release.yaml)",
  "type": "object",
  "required": ["target", "architecture", "media", "release_channel", "base", "boot", "image_format", "full_build"],
  "properties": {
    "target": {"const": "a95x-f3-air"},
    "architecture": {"const": "arm64"},
    "media": {"const": "removable-sd"},
    "release_channel": {"enum": ["dev", "beta", "stable"]},
    "base": {"const": "debian-trixie"},
    "boot": {"const": "vendor-u-boot-sd-autoscript"},
    "image_format": {"const": "raw-gz"},
    "full_build": {"const": "github-actions-only"}
  },
  "additionalProperties": false
}
